#!/bin/sh
set -eu

install -d -m 0755 /usr/local/bin
cat > /usr/local/bin/limt-settings <<'EOF'
#!/bin/sh
set -eu
choice="$(zenity --list --title='Limt-OS Settings' --text='Choose a system settings panel' --column='Settings' 'Display' 'Network' 'Keyboard' 'Window Manager' 'About Limt-OS' 2>/dev/null)" || exit 0
case "$choice" in
  Display) exec xfce4-display-settings ;;
  Network) exec nm-connection-editor ;;
  Keyboard) exec xfce4-keyboard-settings ;;
  'Window Manager') exec xfwm4-tweaks-settings ;;
  'About Limt-OS') zenity --info --title='About Limt-OS' --text='Limt-OS live x86_64 preview\nDebian live system with XFCE, QEMU and VM guest tools.' ;;
esac
EOF
chmod 0755 /usr/local/bin/limt-settings

install -d -m 0755 /etc/skel/Desktop
cat > /etc/skel/Desktop/Limt-Settings.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Limt-OS Settings
Comment=Configure the Limt-OS desktop
Exec=limt-settings
Icon=preferences-system
Terminal=false
Categories=Settings;
EOF
chmod 0644 /etc/skel/Desktop/Limt-Settings.desktop
