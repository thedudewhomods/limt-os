# Set this only in your private server environment; never commit a real key.
OPENAI_API_KEY=put_your_provider_key_here

# Leave unset for the official OpenAI API. For an OpenAI-compatible gateway,
# set its documented API base URL, for example https://openrouter.ai/api/v1.
# OPENAI_BASE_URL=

OPENAI_MODEL=gpt-5.5
# Comma-separated models exposed in the app's model picker.
OPENAI_ALLOWED_MODELS=gpt-5.5
